# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Env files (never commit real secrets/keys)
.env
.env.local
.env.*.local
!.env.example

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
*-debug.log
.firebaserc

# Editor/OS
.DS_Store
*.local

# Test artifacts
coverage/
playwright-report/
test-results/
# Graphify machine state / caches (not portable across clones)
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_labels.json
graphify-out/cost.json
graphify-out/manifest.json
graphify-out/cache/
graphify-out/<graphify>/
graphify-out/reflections/
graphify-out/LESSONS.md

# Any graphify scratch dir nested under scanned subfolders (e.g. web/graphify-out/ast|semantic|stat-index caches)
**/graphify-out/cache/

# Keep the graph outputs:
# !graphify-out/graph.json
# !graphify-out/graph.html
# !graphify-out/GRAPH_REPORT.md
