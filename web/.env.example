# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real Firebase keys or secrets.

# Firebase web app config (from Firebase Console > Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-amore
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" for local development to connect to the Firebase Emulator
# Suite instead of a real project (see quickstart.md).
VITE_USE_EMULATOR=true

# Business contact details used for WhatsApp / Instagram links (FR-006/007/008).
# Placeholder values below — replace with real business details (Section 8 of
# Requirements/Website_and_App_Requirements_Document.md) before going live.
VITE_WHATSAPP_NUMBER=919999999999
VITE_INSTAGRAM_HANDLE=amore.jewelry
