# Soft-launch / production build env.
# Copy to .env.production.local (git-ignored via *.local) and fill real values.
# Vite loads this automatically for `npm run build`.

# Firebase web app config (Console → Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must be false for a real Firebase project deploy
VITE_USE_EMULATOR=false

# Soft-launch placeholders are OK; swap for real business values at go-live
VITE_WHATSAPP_NUMBER=919999999999
VITE_INSTAGRAM_HANDLE=amore.jewelry
