rules_version = '2';

// Implements specs/001-amore-jewelry-catalogue/contracts/security-rules.md:
// public read on catalogue data, authenticated-only write, identical grants
// for all authenticated accounts (Constitution Principle V: no roles).
service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /styleTags/{styleTagId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /staff/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /homepageSections/{sectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /homepageConfig/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
